{
  "name": "podway",
  "version": "0.0.0",
  "private": true,
  "description": "Podway — marketplace of one-click agent environments",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  },
  "scripts": {
    "e2e": "pnpm -F @podway/web e2e",
    "coverage": "pnpm -r exec vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "skills:registry": "node scripts/skills/build-registry.mjs",
    "skills:check": "node scripts/skills/build-registry.mjs --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9"
  }
}