# listmonk per-app config for the shared app-admin engine (environments/_shared/app-admin).
APP_PROJECT=listmonk
APP_SERVICE=listmonk
APP_IMAGE_VAR=LISTMONK_IMAGE
APP_HEALTH_URL=http://localhost:3000/admin/login
DB_TYPE=postgres
DB_SERVICE=postgres
DB_USER=listmonk
DB_NAME=listmonk
APP_DATA_VOLUMES="uploads"
