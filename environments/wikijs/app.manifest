# Wiki.js per-app config for the shared app-admin engine (environments/_shared/app-admin).
APP_PROJECT=wikijs
APP_SERVICE=wikijs
APP_IMAGE_VAR=WIKIJS_IMAGE
# Health hits a backend/DB-aware endpoint (not a static page) so a dead backend or DB outage is caught,
# not masked. Verified 200-on-healthy by app-smoke 2026-09-23.
APP_HEALTH_URL=http://localhost:3000/healthz
APP_HEALTH_RETRIES=60
DB_TYPE=postgres
DB_SERVICE=postgres
DB_USER=wiki
DB_NAME=wiki
APP_DATA_VOLUMES=""
